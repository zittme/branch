<table name="branch_branch">
	<column name="branch_srl" type="bigint" notnull="notnull" primarykey="primarykey" />
	<column name="module_srl" type="bigint" notnull="notnull" default="0" index="idx_module_srl" />
	<!-- 사람이 읽는 짧은 식별자. 다른 모듈이나 외부 연동에서 번호 대신 쓴다 -->
	<column name="code" type="varchar" size="40" index="idx_code" />
	<column name="name" type="varchar" size="150" notnull="notnull" />
	<column name="summary" type="varchar" size="250" />
	<column name="content" type="text" />
	<column name="thumb" type="varchar" size="250" />
	<!-- 사진 여러 장. 주소 목록 JSON -->
	<column name="images" type="text" />
	<column name="tel" type="varchar" size="40" />
	<column name="postcode" type="varchar" size="10" />
	<column name="address" type="varchar" size="250" />
	<column name="address_detail" type="varchar" size="250" />
	<!-- 지도와 가까운 지점 찾기에 쓴다 -->
	<column name="lat" type="varchar" size="20" />
	<column name="lng" type="varchar" size="20" />
	<!-- 시도 또는 권역. 목록에서 묶어 보여 준다 -->
	<column name="region" type="varchar" size="60" index="idx_region" />
	<!-- 주차, 와이파이 같은 편의시설. 쉼표로 구분한다 -->
	<column name="amenities" type="varchar" size="250" />
	<!-- open = 영업 / closed = 영업 종료 / ready = 준비 중 -->
	<column name="status" type="varchar" size="20" notnull="notnull" default="open" index="idx_status" />
	<column name="list_order" type="bigint" notnull="notnull" default="0" index="idx_list_order" />
	<column name="regdate" type="char" size="14" index="idx_regdate" />
	<column name="last_update" type="char" size="14" />
</table>
